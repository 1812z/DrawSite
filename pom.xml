    <groupId>com.z1812</groupId>
    <artifactId>DrawSite</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>DrawSite</name>
    <description>DrawSite</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
